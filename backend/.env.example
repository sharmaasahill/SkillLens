# Copy this file to backend/.env and fill in real values. Never commit .env.

# Secret used to sign login tokens (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Login session lifetime: short-lived access token, longer refresh token
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Set true when the site is served over HTTPS (cookies are then sent only over HTTPS).
# If the frontend and API are on different domains, also use JWT_COOKIE_SAMESITE=None.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Database (defaults to SQLite at backend/instance/salary_predictor.db)
# On the live site, paste the Neon link (postgresql://...); the driver name is added automatically.
DATABASE_URL=sqlite:///salary_predictor.db

# Proxies in front of the app. Use 1 on Render so rate limits see each visitor's real IP.
PROXY_COUNT=0

# Where uploaded resumes are stored (defaults to backend/uploaded_resumes)
# UPLOAD_FOLDER=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Rate limiting. Use a Redis URI (redis://host:6379) when running several workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=5 per minute;30 per hour

# Load ML models at startup instead of on the first request
PRELOAD_MODELS=true

# Set to true only for local development
FLASK_DEBUG=false

# Address the dev server binds to (use 0.0.0.0 only if you need LAN access, never with debug on)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional: AI resume review with Google Gemini. Free key: https://aistudio.google.com (Get API key).
# The resume is sent with the name, phone, email and links removed. On the free tier Google may use
# requests to improve its products. Leave blank to hide the AI coach.
GEMINI_API_KEY=
# Models tried in order; when one is busy or out of free quota, the next is used
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# AI reviews per day for the whole site, and per user. Repeats of the same resume and JD are free.
AI_DAILY_LIMIT=40
AI_USER_DAILY_LIMIT=10

# ---------- Live job search (Jobs page) ----------
# Only the role, city and date range are sent to these sources, never resume text or personal details.
# Sources without a key are skipped. Career pages and remote boards need no key and are on by default.
# Check your setup any time with:  flask --app app check-job-sources   (add --paid to test keyed sources)

# JSearch = Google for Jobs (LinkedIn, Indeed, Glassdoor and other sites Google indexes). Free: 200 searches a month.
# Key from https://www.openwebninja.com/api/jsearch, or set JSEARCH_VIA=rapidapi with a RapidAPI key.
JSEARCH_API_KEY=
JSEARCH_VIA=openwebninja

# Apify runs the Naukri, LinkedIn and Wellfound scrapers. Free plan: $5 of credit every month.
# Token from https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_NAUKRI_ACTOR=valig/naukri-jobs-scraper
APIFY_LINKEDIN_ACTOR=valig/linkedin-jobs-scraper
APIFY_WELLFOUND_ACTOR=blackfalcondata/wellfound-scraper
APIFY_RESULTS_PER_RUN=25
# Apify stops a run that would cost more than this (USD)
APIFY_MAX_USD_PER_RUN=0.15

# Jooble: 500 searches in total for the life of a key. Register at https://in.jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_HOST=in.jooble.org

# TheirStack: free account credits, 1 credit per job returned. Key from https://app.theirstack.com/settings/api-key
THEIRSTACK_API_KEY=
THEIRSTACK_RESULTS=10

# Himalayas works without a key; a free key raises its limits. https://himalayas.app/api
HIMALAYAS_API_KEY=

# Adzuna (free key for personal/academic use): https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Careerjet (free publisher key, needs your live website address): https://www.careerjet.com/partners/
CAREERJET_API_KEY=

# Searches per day for each source, all users together. Defaults protect each free quota:
# jsearch 6, jooble 3, adzuna 20, careerjet 20, theirstack 1, apify_naukri 3, apify_linkedin 3,
# apify_wellfound 1 (together about $4.50 of Apify credit if used every day), remotive 4, himalayas 200, remoteok 48, greenhouse/lever/ashby 500.
# Override one with JOB_LIMIT_<SOURCE>, for example:
# JOB_LIMIT_JSEARCH=6
# Turn off sources that need no key, e.g. JOB_SOURCES_DISABLED=remoteok,remotive
JOB_SOURCES_DISABLED=
# Job searches per user per day (repeats of the same search are free)
JOB_SEARCH_USER_DAILY_LIMIT=30

# The one admin account. Signing in with this email opens the admin dashboard; every other email
# is a regular user. It is created on its first sign-in, on any database (set the same values on Render).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Shown on the Privacy Policy page (/privacy) for questions and data requests
CONTACT_EMAIL=

# Google sign-in (see README, "Google sign-in"). Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the exact callback registered with Google; worked out from the request when empty
GOOGLE_REDIRECT_URI=
# Locally with `npm start`, the page to return to after Google sign-in. Leave empty on the live site.
FRONTEND_URL=http://localhost:3000

# Housekeeping: cached job results older than this many days are deleted; the database limit shown
# in the admin dashboard (Neon's free plan is 1 GB per project)
CACHE_KEEP_DAYS=7
DATABASE_LIMIT_MB=1024
