# Copy this file to backend/.env and fill in real values. Never commit .env.

# Secret used to sign login tokens (required). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Login session lifetime: short-lived access token, longer refresh token
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Set true when the site is served over HTTPS (cookies are then sent only over HTTPS).
# If the frontend and API are on different domains, also use JWT_COOKIE_SAMESITE=None.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Database (defaults to SQLite at backend/instance/salary_predictor.db)
DATABASE_URL=sqlite:///salary_predictor.db

# Where uploaded resumes are stored (defaults to backend/uploaded_resumes)
# UPLOAD_FOLDER=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Rate limiting. Use a Redis URI (redis://host:6379) when running several workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=5 per minute;30 per hour
PUBLIC_API_RATE_LIMIT=30 per minute

# Load ML models at startup instead of on the first request
PRELOAD_MODELS=true

# Set to true only for local development
FLASK_DEBUG=false

# Address the dev server binds to (use 0.0.0.0 only if you need LAN access, never with debug on)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# HR account created by `python create_hr_user.py` (password: 8+ characters)
HR_EMAIL=hr@example.com
HR_PASSWORD=change-me-please
HR_NAME=HR Manager
